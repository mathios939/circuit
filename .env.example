# ---------------------------------------------------------------------------
# Circuit — configuration des fournisseurs externes
# Copiez ce fichier vers `.env.local` et adaptez les valeurs.
# Aucune clé privée n'est jamais envoyée au navigateur : seules les variables
# préfixées par NEXT_PUBLIC_ sont exposées côté client.
# ---------------------------------------------------------------------------

# ----- Routing (calcul d'itinéraires) --------------------------------------
# valhalla        : instance publique FOSSGIS (sans clé, usage raisonnable) ou auto-hébergée
# graphhopper     : GraphHopper Directions API (clé requise, boucles natives)
# openrouteservice: openrouteservice.org (clé requise, boucles natives)
# osrm            : instance OSRM auto-hébergée (profils bike/foot à construire)
# mock            : moteur synthétique déterministe — TESTS UNIQUEMENT
ROUTING_PROVIDER=valhalla

# Valhalla — URL de base (par défaut : instance publique FOSSGIS, à remplacer
# par votre propre instance en production : https://github.com/valhalla/valhalla)
ROUTING_VALHALLA_URL=https://valhalla1.openstreetmap.de

# GraphHopper — clé à créer sur https://www.graphhopper.com/ (offre gratuite disponible)
# GRAPHHOPPER_API_KEY=
# GRAPHHOPPER_URL=https://graphhopper.com/api/1

# openrouteservice — clé à créer sur https://openrouteservice.org/dev/#/signup
# OPENROUTESERVICE_API_KEY=
# OPENROUTESERVICE_URL=https://api.openrouteservice.org

# OSRM — URL de votre instance (ex. http://localhost:5000). Les profils
# `bike` et `foot` doivent être compilés avec les profils Lua correspondants.
# ROUTING_OSRM_URL=http://localhost:5000

# Délai maximal (ms) d'un appel de routing
ROUTING_TIMEOUT_MS=20000
# Nombre d'appels de routing simultanés autorisés lors d'une génération
ROUTING_CONCURRENCY=3

# ----- Géocodage (recherche d'adresses) ------------------------------------
# photon    : photon.komoot.io (sans clé, autocomplétion, usage raisonnable)
# nominatim : nominatim.openstreetmap.org (sans clé, 1 req/s max, pas d'autocomplétion intensive)
# mock      : TESTS UNIQUEMENT
GEOCODING_PROVIDER=photon
# GEOCODING_PHOTON_URL=https://photon.komoot.io
# GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim et Photon demandent un User-Agent identifiant l'application (avec contact).
GEOCODING_USER_AGENT="circuit-app/0.1 (contact@example.com)"

# ----- Altitude ------------------------------------------------------------
# open-meteo   : api.open-meteo.com (sans clé, 100 points / requête)
# opentopodata : api.opentopodata.org (sans clé, 100 points / requête, 1 req/s)
# valhalla     : endpoint /height de l'instance Valhalla configurée (1 requête par parcours)
# mock         : TESTS UNIQUEMENT
ELEVATION_PROVIDER=open-meteo
# ELEVATION_OPEN_METEO_URL=https://api.open-meteo.com/v1/elevation
# ELEVATION_OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm30m
# Nombre maximal de points échantillonnés par parcours pour le profil altimétrique
ELEVATION_SAMPLE_POINTS=300

# ----- Carte (côté client) -------------------------------------------------
# openfreemap : tuiles vectorielles gratuites sans clé (https://openfreemap.org)
# maptiler    : MapTiler Cloud (clé PUBLIQUE, à restreindre par domaine) — ajoute
#               les fonds outdoor, topo et satellite.
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
# Clé MapTiler : https://cloud.maptiler.com/account/keys/
# NEXT_PUBLIC_MAPTILER_KEY=

# ----- Sécurité / limites --------------------------------------------------
# Requêtes autorisées par IP et par minute sur les API internes
RATE_LIMIT_PER_MINUTE=60
# Taille maximale d'un fichier GPX importé (octets)
GPX_MAX_FILE_BYTES=10485760

# ----- Langage naturel (optionnel) -----------------------------------------
# Par défaut, l'interprétation des demandes en langage naturel est faite par
# un analyseur à base de règles (aucune clé nécessaire). L'architecture
# (src/lib/nl) permet de brancher un LLM ultérieurement.
NL_PARSER=rules
