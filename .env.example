# ===========================================================================
# Circuit — configuration serveur
# Copiez ce fichier vers `.env.local` puis adaptez les valeurs.
#
# La configuration est validée au démarrage (Zod, src/lib/server/env.ts) :
# une valeur invalide ou une clé manquante pour le fournisseur choisi provoque
# une erreur explicite (« Configuration serveur invalide — … »).
#
# Légende :  [OBLIGATOIRE]  [OPTIONNEL]  [PROD]  [DEV]
# Seules les variables NEXT_PUBLIC_* sont exposées au navigateur.
# ===========================================================================

# ---------------------------------------------------------------------------
# Mode démo                                                          [OPTIONNEL]
# ---------------------------------------------------------------------------
# true : tous les fournisseurs sont remplacés par des moteurs synthétiques et
# un bandeau « Mode démo » est affiché. Permet de montrer l'interface sans
# consommer d'API. Jamais des données réelles.
NEXT_PUBLIC_DEMO_MODE=false
# Les fournisseurs `mock` sont refusés sur un build de production, sauf avec
# ce drapeau explicite (utilisé par les tests E2E). Ne pas activer en prod.  [DEV]
# ALLOW_MOCK_PROVIDERS=false

# ---------------------------------------------------------------------------
# Routing (calcul d'itinéraires)                                     [OBLIGATOIRE]
# ---------------------------------------------------------------------------
# Moteur principal : valhalla | graphhopper | openrouteservice | osrm | mock
#   valhalla         instance publique FOSSGIS sans clé (usage raisonnable) ou auto-hébergée
#   graphhopper      Directions API (clé requise) — boucles natives, altitude et surfaces incluses
#   openrouteservice api.openrouteservice.org (clé requise) — boucles natives
#   osrm             instance auto-hébergée (profils bike/foot à construire)
#   mock             moteur synthétique déterministe — TESTS UNIQUEMENT (refusé en production)
ROUTING_PROVIDER_PRIMARY=valhalla
# Ancien nom encore accepté : ROUTING_PROVIDER=valhalla

# Moteur de secours, utilisé UNIQUEMENT si le principal est indisponible
# (timeout, 429, 5xx, réseau) — jamais lorsqu'une route est impossible.  [OPTIONNEL]
# ROUTING_PROVIDER_FALLBACK=openrouteservice

# Valhalla — URL de base. [PROD] remplacez l'instance publique par la vôtre
# (https://github.com/valhalla/valhalla) : l'instance FOSSGIS est réservée à
# un usage modéré.
ROUTING_VALHALLA_URL=https://valhalla1.openstreetmap.de

# GraphHopper — clé : https://www.graphhopper.com/ (offre gratuite)   [requis si graphhopper]
# GRAPHHOPPER_API_KEY=
# GRAPHHOPPER_URL=https://graphhopper.com/api/1

# openrouteservice — clé : https://openrouteservice.org/dev/#/signup  [requis si openrouteservice]
# OPENROUTESERVICE_API_KEY=
# OPENROUTESERVICE_URL=https://api.openrouteservice.org

# OSRM — URL de votre instance et noms des profils compilés         [requis si osrm]
# ROUTING_OSRM_URL=http://localhost:5000
# ROUTING_OSRM_BICYCLE_PROFILE=bike
# ROUTING_OSRM_PEDESTRIAN_PROFILE=foot

# Délai maximal d'un appel de routing (ms, 1000–120000)               [OPTIONNEL]
ROUTING_TIMEOUT_MS=20000
# Appels de routing simultanés pendant une génération (1–10)         [OPTIONNEL]
ROUTING_CONCURRENCY=3

# ----- Générateur de boucles ------------------------------------------------
# Nombre de candidats initiaux (directions × stratégies), 3–30.       [OPTIONNEL]
# Plus il est élevé, meilleure est la sélection… et plus d'appels API.
ROUTE_CANDIDATE_COUNT=12
# Passes d'ajustement de la distance par candidat (0–5)               [OPTIONNEL]
ROUTE_MAX_ITERATIONS=2
# Budget maximal d'appels de routing pour une génération (5–120)      [OPTIONNEL]
ROUTE_MAX_ROUTING_CALLS=40

# ---------------------------------------------------------------------------
# Géocodage (recherche de lieux)                                      [OBLIGATOIRE]
# ---------------------------------------------------------------------------
# photon    : photon.komoot.io (sans clé, autocomplétion, usage raisonnable)
# nominatim : nominatim.openstreetmap.org (sans clé, 1 req/s — appliqué automatiquement)
# mock      : TESTS UNIQUEMENT
GEOCODING_PROVIDER=photon
# Secours automatique : photon ⇄ nominatim. Forcer avec :             [OPTIONNEL]
# GEOCODING_PROVIDER_FALLBACK=nominatim
# GEOCODING_PHOTON_URL=https://photon.komoot.io
# GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Adresse de contact transmise à Nominatim (recommandé par sa politique) [OPTIONNEL]
# GEOCODING_NOMINATIM_EMAIL=contact@example.com
# User-Agent identifiant l'application — exigé par Photon et Nominatim  [PROD]
GEOCODING_USER_AGENT="circuit-app/0.1 (contact@example.com)"

# ---------------------------------------------------------------------------
# Altitude                                                            [OBLIGATOIRE]
# ---------------------------------------------------------------------------
# open-meteo   : api.open-meteo.com (sans clé, 100 points / requête)
# opentopodata : api.opentopodata.org (sans clé, 100 points / requête, 1 req/s appliqué)
# valhalla     : endpoint /height de l'instance Valhalla configurée
# mock         : TESTS UNIQUEMENT
ELEVATION_PROVIDER=open-meteo
# Chaîne de secours (liste séparée par des virgules). Défaut : valhalla   [OPTIONNEL]
# Dernier recours implicite : le parcours est proposé sans altitude.
# ELEVATION_PROVIDER_FALLBACK=valhalla,opentopodata
# ELEVATION_OPEN_METEO_URL=https://api.open-meteo.com/v1/elevation
# ELEVATION_OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm30m
# Points échantillonnés par parcours pour le profil (50–2000)          [OPTIONNEL]
ELEVATION_SAMPLE_POINTS=300

# ---------------------------------------------------------------------------
# Carte (côté client)                                                 [OBLIGATOIRE]
# ---------------------------------------------------------------------------
# openfreemap : tuiles vectorielles gratuites sans clé (https://openfreemap.org)
# maptiler    : MapTiler Cloud (clé PUBLIQUE à restreindre par domaine) —
#               ajoute Outdoor, Topo et Satellite.
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
# Clé MapTiler : https://cloud.maptiler.com/account/keys/              [OPTIONNEL]
# NEXT_PUBLIC_MAPTILER_KEY=

# ---------------------------------------------------------------------------
# Limites de débit (par IP et par minute)                             [OPTIONNEL]
# ---------------------------------------------------------------------------
# Base utilisée pour dériver les limites non renseignées :
#   geocoding = 2 × base, generation = base / 5, calculate = base, import = base
RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_GEOCODING_PER_MINUTE=120
# RATE_LIMIT_GENERATION_PER_MINUTE=12
# RATE_LIMIT_CALCULATE_PER_MINUTE=60
# RATE_LIMIT_IMPORT_PER_MINUTE=60
# RATE_LIMIT_DIAGNOSTICS_PER_MINUTE=6
# Taille maximale d'un fichier GPX importé (octets)                   [OPTIONNEL]
GPX_MAX_FILE_BYTES=10485760

# ---------------------------------------------------------------------------
# Observabilité et diagnostics                                        [OPTIONNEL]
# ---------------------------------------------------------------------------
# Niveau de log : debug | info | warn | error | silent (défaut : debug en dev, info en prod)
# LOG_LEVEL=info
# Format : pretty (dev) | json (prod, une ligne JSON par événement)
# LOG_FORMAT=json
# Écran /diagnostics et sondes /api/health?probe=1 : activés en dev,
# désactivés en production sauf si true.                                [PROD]
# DIAGNOSTICS_ENABLED=false
# Panneau debug d'un parcours dans l'interface (toujours actif en dev)  [PROD]
# NEXT_PUBLIC_DEBUG_ROUTES=false

# ---------------------------------------------------------------------------
# Langage naturel                                                     [OPTIONNEL]
# ---------------------------------------------------------------------------
# rules : analyseur à base de règles (aucune clé). L'interface RouteIntentParser
# (src/lib/nl) permet de brancher un LLM ultérieurement.
NL_PARSER=rules
